# SETTINGS: existing directory on the NAS ext4 volume, not the Mac OneDrive tree.
BAM_EXT4_ROOT=/replace/with/actual/ext4/path/bam-local-review
BAM_UID=1000
BAM_GID=1000
OLLAMA_MEMORY_LIMIT=12g
OLLAMA_CPU_LIMIT=4
OLLAMA_IMAGE=ollama/ollama:latest
LOCAL_INFORMED_MODEL=gemma3:4b
LOCAL_BLIND_MODEL=qwen2.5vl:3b
LOCAL_MERGER_MODEL=qwen3:4b
LOCAL_ARBITER_MODEL=llama3.2-vision:11b
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# CREDENTIALS: none for local inference. Optional OpenRouter key goes in
# $BAM_EXT4_ROOT/state/secrets/openrouter.key (0600), never here/in Git.
