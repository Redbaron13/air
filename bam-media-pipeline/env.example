# Copy to bam-media-pipeline/.env and replace all placeholders. Never commit .env.
POSTGRES_DB=bam_media_factory
POSTGRES_USER=bam_admin
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://bam_admin:CHANGE_ME@postgres:5432/bam_media_factory
REDIS_URL=redis://redis:6379/0
ONEDRIVE_SOURCE_PATH=/srv/bam/media/onedrive-readonly
PIPELINE_STORAGE_PATH=/srv/bam/media
# Default offline/local. Set backend only after configuring provider.
BAM_VISION_BACKEND=ollama
OLLAMA_URL=http://host.docker.internal:11434
BAM_VISION_MAX_EDGE=1600
BAM_VISION_LIMIT=180
# Optional cloud AI services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Optional Azure upload / VPN workflow
TS_AUTHKEY=
TS_HOSTNAME=bam-nas-pipeline
# Review rsync_to_azure.sh / run_azure_batch.sh before use: additional cloud host configuration may be required.
