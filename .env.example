# Non-secret settings can be committed here. Keychain values use {{keychain:NAME}}.
POSTGRES_DB=bam_media_factory
POSTGRES_USER=bam_admin
POSTGRES_PASSWORD={{keychain:POSTGRES_PASSWORD}}
DATABASE_URL={{keychain:DATABASE_URL}}
NEON_DATABASE_URL={{keychain:NEON_DATABASE_URL}}
REDIS_URL=redis://redis:6379
OLLAMA_URL=http://host.docker.internal:11434
ONEDRIVE_SOURCE_PATH=/absolute/path/to/source-media
PIPELINE_STORAGE_PATH=/absolute/path/to/air/storage
PIPELINE_VERBOSE=0
R2_ACCOUNT_ID={{keychain:R2_ACCOUNT_ID}}
R2_ACCESS_KEY_ID={{keychain:R2_ACCESS_KEY_ID}}
R2_SECRET_ACCESS_KEY={{keychain:R2_SECRET_ACCESS_KEY}}
R2_BUCKET=bam-media-production
S3_ENDPOINT_CLOUDFLARE={{keychain:S3_ENDPOINT_CLOUDFLARE}}
CLOUDFLARE_API_TOKEN={{keychain:CLOUDFLARE_API_TOKEN}}