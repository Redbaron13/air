# BAM Media Pipeline environment variables
PORT=3000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database. Leave the URLs empty to keep sync as a no-op.
# docker compose -f docker-compose.yml up -d uses these three local defaults.
# POSTGRES_PASSWORD is a placeholder for that local database, not a production secret.
POSTGRES_DB=bam_media_factory
POSTGRES_USER=bam_admin
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=
# postgresql://bam_admin:local-dev-only@127.0.0.1:5432/bam_media_factory
NEON_DATABASE_URL=
REDIS_URL=
# redis://127.0.0.1:6379/0

# Local library created by setup.sh
AIR_LIBRARY=library

# Pipeline vision backend: skip, ollama, or azure.
# skip is used when AIR_VISION_BACKEND is empty and OLLAMA_URL is empty.
AIR_VISION_BACKEND=skip
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5-vl:3b
AZURE_OPENAI_ENDPOINT=https://bam-pipeline.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Public watermark text. Originals are not overwritten.
AIR_WATERMARK_TEXT=Baron Aerial Media

# R2. publish skips the upload when any of these are empty.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Review console settings retained from the existing example.
BAM_VISION_BACKEND=ollama
BAM_VISION_MAX_EDGE=1600
BAM_VISION_LIMIT=180
LOCAL_INFORMED_MODEL=gemma3:4b
LOCAL_BLIND_MODEL=qwen2.5vl:3b
LOCAL_MERGER_MODEL=qwen3:4b
LOCAL_ARBITER_MODEL=llama3.2-vision:11b
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REVIEW_GROUP_RADIUS_M=150
REVIEW_STUCK_MINUTES=60
GEOCODE_ENABLED=0
PIPELINE_STORAGE_PATH=/storage
ACTIVE_DIR=/storage/active
ORIGINALS_DIR=/storage/originals
EXPORTS_DIR=/storage/exports
ONEDRIVE_SOURCE_PATH=
